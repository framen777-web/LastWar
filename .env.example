# Copy this file to .env and fill in a real connection string. .env is gitignored.

# Postgres connection string. Render's dashboard shows this as the database's "External
# Database URL" (or "Internal Database URL" if the app and database are both on Render, in
# the same region - internal is faster and doesn't count against Render's bandwidth).
# Local dev needs its own Postgres instance too (a second free Render Postgres, Neon, or a
# local install all work) - schema.prisma only supports one provider at a time now that
# it's "postgresql", so pointing this at a SQLite file no longer works.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
