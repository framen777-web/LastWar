# Copy this file to .env.local and fill in your key. .env.local is gitignored.

# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default model (gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Signs login session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
