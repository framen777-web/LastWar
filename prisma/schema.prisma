// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  aliases      String   @default("")
  allianceRank String?
  status       String?
  lastActive   String?
  squadAir     Float?
  squadTank    Float?
  squadMissile Float?
  squadFourth  Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Login access. passwordHash null = no login access granted yet. role null = auto
  // (derive from allianceRank, see lib/auth/roles.ts); non-null = manual override.
  passwordHash String?
  role         String?
  isActive     Boolean @default(true)
  theme        String  @default("default")

  // false = auto-created by the screenshot pipeline and not yet reviewed by an
  // admin (see lib/pipeline/matchMember.ts). Existing rows default to true so
  // this doesn't retroactively flag your whole current roster.
  nameConfirmed Boolean @default(true)

  // Self-reported, optional - so an admin has a way to reach a member who's locked out to
  // arrange a manual password reset (Setup -> Users already lets an admin set a new
  // password directly; nothing else reads these fields).
  contactWhatsapp String?
  contactEmail    String?

  weeklyStats         WeeklyStat[]
  categoryRecords     CategoryRecord[]
  suggestions         Suggestion[]
  conductorSelections ConductorSelection[]
}

model Category {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  name         String   @unique
  description  String?
  shape        String
  divisor      Float    @default(1)
  divisorLabel String?
  importMode   String   @default("single")
  dedupField   String?
  storedFields String   @default("[]")
  valueField   String   @default("value")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  // Lifetime-cumulative raw reading (e.g. Kills) rather than a per-week figure - the
  // Conductor points engine and Passenger ranking need the week-over-week gain, not the
  // raw value, for any category flagged this way.
  cumulative Boolean @default(false)

  // Conductor points config: "off" | "rate" | "flat". "rate" scores
  // (weekly value / conductorUnitSize) * conductorPointsPerUnit; "flat" scores
  // conductorFlatValue if the member has any value for that week, regardless of size.
  conductorMode          String @default("off")
  conductorPointsPerUnit Float?
  conductorUnitSize      Float?
  conductorFlatValue     Float?

  records CategoryRecord[]
}

// Simple key/value app settings (e.g. WhatsApp share number), configured from Setup.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// One row per navigable menu button in the app - governs whether that button renders for
// a given role (fail-closed: a role not listed here can't see it). This only controls
// button *visibility* as a navigation aid - it does not replace each page's own
// requireRole()/requireAdmin() guard, which remains the real access control. Granting a
// role visibility here without also loosening that page's own guard just produces a
// button that leads to a redirect - the two aren't automatically kept in sync.
model MenuItem {
  key       String   @id
  label     String
  href      String
  roles     String // JSON array of "ADMIN" | "LEADER" | "MEMBER"
  // Display order for the Menu Access admin table only (main menu items followed by their
  // submenus, matching the real nav hierarchy) - has no effect on how/where a button
  // actually renders, which stays controlled by each hub page's own JSX.
  sortOrder Int      @default(0)
  // The parent MenuItem's key, or null for a main menu item - lets the Menu Access admin
  // page render an actual tree matching the real nav structure, and cascade a role change
  // down to a whole branch at once. Not a Prisma relation on purpose (keeps this a plain,
  // easy-to-query self-reference) - resolved manually in lib/menuAccess.ts.
  parentKey String?
  updatedAt DateTime @updatedAt
}

// The R1 Report's Promote/Watch flag, keyed per member per week so notes from
// one week never bleed into another.
model Suggestion {
  id         Int      @id @default(autoincrement())
  memberId   Int
  member     Member   @relation(fields: [memberId], references: [id])
  weekNumber Int
  value      String?
  updatedAt  DateTime @updatedAt

  @@unique([memberId, weekNumber])
}

model RawExtraction {
  id            Int      @id @default(autoincrement())
  imageFilename String
  categoryKey   String
  weekNumber    Int
  rawJson       String
  confidence    Float
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}

model WeeklyStat {
  id          Int      @id @default(autoincrement())
  memberId    Int
  member      Member   @relation(fields: [memberId], references: [id])
  weekNumber  Int
  categoryKey String
  value       Float
  rank        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([memberId, weekNumber, categoryKey])
}

// Generalizes what used to be a bespoke AE-only import table to every category: one
// row per import. Single-mode categories always write dedupKey "" (re-upload
// overwrites in place); multi-mode categories
// resolve dedupKey from the category's configured dedupField (e.g. an in-image event
// date), so re-processed fragments of the same event update in place while a genuinely
// new value adds a new summed row. WeeklyStat.<categoryKey> is always the sum of a
// member/week's CategoryRecord rows for that category.
model CategoryRecord {
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  memberId   Int
  member     Member   @relation(fields: [memberId], references: [id])
  weekNumber Int
  dedupKey   String   @default("")
  rawValue   Float
  value      Float
  rank       Int?
  fields     String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, memberId, weekNumber, dedupKey])
}

// A rotation cycle: weeksInCycle * 7 conductor slots and the same number of passenger
// slots, one of each per calendar day. "draft" rounds can still be edited/regenerated;
// "confirmed" is final and is what standings/history read from.
model ConductorRound {
  id           Int       @id @default(autoincrement())
  weeksInCycle Int
  startWeek    Int
  status       String    @default("draft")
  source       String    @default("generated") // "generated" | "imported" (backfilled history)
  createdAt    DateTime  @default(now())
  confirmedAt  DateTime?

  selections ConductorSelection[]
}

// One member filling one role for one day of a round. Conductor rows freeze the
// member's points balance at selection time in `pointsAtSelection` - that frozen value
// doubles as the ledger "reset" amount standings subtract back out, so no separate
// ledger table is needed. Passenger rows never touch points; they record which
// category/rank (or "random") produced the pick for audit purposes. `memberId` is
// nullable so a slot with no eligible candidate (fewer active members than slots, or
// fewer submissions than a rule's rank that week) still gets a row the admin can fill
// in via override, instead of silently having no row at all.
model ConductorSelection {
  id                Int            @id @default(autoincrement())
  roundId           Int
  round             ConductorRound @relation(fields: [roundId], references: [id])
  memberId          Int?
  member            Member?        @relation(fields: [memberId], references: [id])
  role              String // "conductor" | "passenger"
  slotIndex         Int // 0-based day within the cycle
  weekNumber        Int // which in-cycle week this slot's data was evaluated against
  pointsAtSelection Float? // conductor only
  sourceCategoryKey String? // passenger only - null means "random"
  sourceRank        Int? // passenger only
  manualOverride    Boolean        @default(false)
  createdAt         DateTime       @default(now())

  @@unique([roundId, slotIndex, role])
}
