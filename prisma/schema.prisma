// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  aliases      String   @default("")
  allianceRank String?
  status       String?
  lastActive   String?
  squadAir     Float?
  squadTank    Float?
  squadMissile Float?
  squadFourth  Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Login access. passwordHash null = no login access granted yet. role null = auto
  // (derive from allianceRank, see lib/auth/roles.ts); non-null = manual override.
  passwordHash String?
  role         String?
  isActive     Boolean @default(true)
  theme        String  @default("default")

  // false = auto-created by the screenshot pipeline and not yet reviewed by an
  // admin (see lib/pipeline/matchMember.ts). Existing rows default to true so
  // this doesn't retroactively flag your whole current roster.
  nameConfirmed Boolean @default(true)

  // Self-reported, optional - so an admin has a way to reach a member who's locked out to
  // arrange a manual password reset (Setup -> Users already lets an admin set a new
  // password directly; nothing else reads these fields).
  contactWhatsapp String?
  contactEmail    String?

  weeklyStats         WeeklyStat[]
  categoryRecords     CategoryRecord[]
  suggestions         Suggestion[]
  conductorSelections ConductorSelection[]
  seasonExtraValues   SeasonExtraValue[]
  seasonResults       SeasonResult[]
  pivotViews          PivotView[]
  feedbackItems       FeedbackItem[]
}

model Category {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  name         String   @unique
  description  String?
  shape        String
  divisor      Float    @default(1)
  divisorLabel String?
  importMode   String   @default("single")
  dedupField   String?
  storedFields String   @default("[]")
  valueField   String   @default("value")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  // Lifetime-cumulative raw reading (e.g. Kills) rather than a per-week figure - the
  // Conductor points engine and Passenger ranking need the week-over-week gain, not the
  // raw value, for any category flagged this way.
  cumulative Boolean @default(false)

  // How this category's per-week values collapse into one number when a report
  // summarises across a range of weeks (Alliance Detail Report's Summary mode and its
  // Excel export) - "sum" | "average" | "max" | "min" | "selected_week". "selected_week"
  // means the value from the last week of the requested range, not a range computation.
  // Meaningless for free_text categories (they never roll up to a single value).
  summaryMode String @default("selected_week")

  // Conductor points config: "off" | "rate" | "flat". "rate" scores
  // (weekly value / conductorUnitSize) * conductorPointsPerUnit; "flat" scores
  // conductorFlatValue if the member has any value for that week, regardless of size.
  conductorMode          String @default("off")
  conductorPointsPerUnit Float?
  conductorUnitSize      Float?
  conductorFlatValue     Float?

  records CategoryRecord[]
}

// Simple key/value app settings (e.g. WhatsApp share number), configured from Setup.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// One row per navigable menu button in the app - governs whether that button renders for
// a given role (fail-closed: a role not listed here can't see it). This only controls
// button *visibility* as a navigation aid - it does not replace each page's own
// requireRole()/requireAdmin() guard, which remains the real access control. Granting a
// role visibility here without also loosening that page's own guard just produces a
// button that leads to a redirect - the two aren't automatically kept in sync.
model MenuItem {
  key       String   @id
  label     String
  href      String
  roles     String // JSON array of "ADMIN" | "LEADER" | "MEMBER"
  // Display order for the Menu Access admin table only (main menu items followed by their
  // submenus, matching the real nav hierarchy) - has no effect on how/where a button
  // actually renders, which stays controlled by each hub page's own JSX.
  sortOrder Int      @default(0)
  // The parent MenuItem's key, or null for a main menu item - lets the Menu Access admin
  // page render an actual tree matching the real nav structure, and cascade a role change
  // down to a whole branch at once. Not a Prisma relation on purpose (keeps this a plain,
  // easy-to-query self-reference) - resolved manually in lib/menuAccess.ts.
  parentKey String?
  updatedAt DateTime @updatedAt
}

// The R1 Report's Promote/Watch flag, keyed per member per week so notes from
// one week never bleed into another.
model Suggestion {
  id         Int      @id @default(autoincrement())
  memberId   Int
  member     Member   @relation(fields: [memberId], references: [id])
  weekNumber Int
  value      String?
  updatedAt  DateTime @updatedAt

  @@unique([memberId, weekNumber])
}

// Per-week window length for the R1 report's bottom panel, so a week's report stays
// reproducible after the global default changes later. Resolved lazily: the first time a
// week is viewed, whatever the global default was gets pinned here and reused on every
// later view of that same week. An admin can also explicitly override one week's window
// from the report toolbar, which overwrites the pin directly.
model R1WeekSettings {
  weekNumber        Int      @id
  bottomWeeksWindow Int
  updatedAt         DateTime @updatedAt
}

model RawExtraction {
  id            Int      @id @default(autoincrement())
  imageFilename String
  categoryKey   String
  weekNumber    Int
  rawJson       String
  confidence    Float
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}

model WeeklyStat {
  id          Int      @id @default(autoincrement())
  memberId    Int
  member      Member   @relation(fields: [memberId], references: [id])
  weekNumber  Int
  categoryKey String
  value       Float
  rank        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([memberId, weekNumber, categoryKey])
  // memberId alone is already covered by the unique index above (leftmost-column lookups
  // are fine on Postgres) - this one is for weekNumber-only filters (e.g.
  // getActiveMemberIdsForWeek), which the unique index can't serve since weekNumber isn't
  // its leading column.
  @@index([weekNumber])
}

// Generalizes what used to be a bespoke AE-only import table to every category: one
// row per import. Single-mode categories always write dedupKey "" (re-upload
// overwrites in place); multi-mode categories
// resolve dedupKey from the category's configured dedupField (e.g. an in-image event
// date), so re-processed fragments of the same event update in place while a genuinely
// new value adds a new summed row. WeeklyStat.<categoryKey> is always the sum of a
// member/week's CategoryRecord rows for that category.
model CategoryRecord {
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  memberId   Int
  member     Member   @relation(fields: [memberId], references: [id])
  weekNumber Int
  dedupKey   String   @default("")
  rawValue   Float
  value      Float
  rank       Int?
  fields     String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, memberId, weekNumber, dedupKey])
  // Neither memberId nor weekNumber is the leading column of the unique index above, so a
  // plain memberId-only lookup (e.g. member merge) or weekNumber-only lookup (e.g.
  // getActiveMemberIdsForWeek) can't use it - both get their own index.
  @@index([memberId])
  @@index([weekNumber])
}

// A rotation cycle: weeksInCycle * 7 conductor slots and the same number of passenger
// slots, one of each per calendar day. "draft" rounds can still be edited/regenerated;
// "confirmed" is final and is what standings/history read from.
model ConductorRound {
  id           Int       @id @default(autoincrement())
  weeksInCycle Int
  startWeek    Int
  status       String    @default("draft")
  source       String    @default("generated") // "generated" | "imported" (backfilled history)
  createdAt    DateTime  @default(now())
  confirmedAt  DateTime?

  selections ConductorSelection[]
}

// One member filling one role for one day of a round. Conductor rows freeze the
// member's points balance at selection time in `pointsAtSelection` - that frozen value
// doubles as the ledger "reset" amount standings subtract back out, so no separate
// ledger table is needed. Passenger rows never touch points; they record which
// category/rank (or "random") produced the pick for audit purposes. `memberId` is
// nullable so a slot with no eligible candidate (fewer active members than slots, or
// fewer submissions than a rule's rank that week) still gets a row the admin can fill
// in via override, instead of silently having no row at all.
model ConductorSelection {
  id                Int            @id @default(autoincrement())
  roundId           Int
  round             ConductorRound @relation(fields: [roundId], references: [id])
  memberId          Int?
  member            Member?        @relation(fields: [memberId], references: [id])
  role              String // "conductor" | "passenger"
  slotIndex         Int // 0-based day within the cycle
  weekNumber        Int // which in-cycle week this slot's data was evaluated against
  pointsAtSelection Float? // conductor only
  sourceCategoryKey String? // passenger only - null means "random"
  sourceRank        Int? // passenger only
  manualOverride    Boolean        @default(false)
  createdAt         DateTime       @default(now())

  @@unique([roundId, slotIndex, role])
  // memberId isn't part of any other index here (the unique above is keyed on
  // roundId/slotIndex/role instead) - a plain memberId lookup (e.g. member merge,
  // standings) would otherwise be a full table scan.
  @@index([memberId])
}

// One reward season - a fixed week range at the end of which contribution is scored and reward
// boxes are distributed. "draft" can still have its scoring config and bands edited, and its
// report is computed live; "final" is locked and its report reads the frozen SeasonResult rows
// instead (mirrors ConductorRound's draft/confirmed convention). scoringMode picks which of the
// two parallel configs below (SeasonCategoryPoints vs SeasonCategoryWeight) is actually used when
// computing the live report or finalizing - both stay saved regardless of which is active, so
// toggling never loses data.
model Season {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  weekStart   Int
  weekEnd     Int
  totalBoxes  Int
  scoringMode String    @default("points") // "points" | "positional"
  status      String    @default("draft") // "draft" | "final"
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryPoints  SeasonCategoryPoints[]
  categoryWeights SeasonCategoryWeight[]
  extraItems      SeasonExtraItem[]
  bands           SeasonBand[]
  results         SeasonResult[]
  rawExtractions  RawSeasonExtraction[]
}

// Points-mode config for one existing Category's contribution to one season's score. Mirrors
// Category.conductorMode/conductorPointsPerUnit/conductorUnitSize/conductorFlatValue, but scoped
// per season instead of global - a category can be worth different points in different seasons,
// and a category not listed here simply doesn't count toward points-mode scoring at all (no "off"
// mode needed - presence in this table IS the "on" switch). Only read when
// Season.scoringMode === "points".
model SeasonCategoryPoints {
  id            Int    @id @default(autoincrement())
  seasonId      Int
  season        Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  categoryKey   String
  mode          String // "rate" | "flat"
  pointsPerUnit Float?
  unitSize      Float?
  flatValue     Float?

  @@unique([seasonId, categoryKey])
}

// Positional-mode config for one existing Category's contribution to one season's score. Presence
// here = included in positional scoring, independent of whether the same category is also
// included in SeasonCategoryPoints for points mode - a category can be in one, both, or neither.
// `weight` is a plain multiplier applied to that category's 0-100 positional score, same
// convention as lib/mvp/weights.ts (weights are typically chosen to sum to ~1, but nothing
// enforces that beyond a soft UI warning). Only read when Season.scoringMode === "positional".
model SeasonCategoryWeight {
  id          Int    @id @default(autoincrement())
  seasonId    Int
  season      Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  categoryKey String
  weight      Float

  @@unique([seasonId, categoryKey])
}

// A season-specific scoring item that doesn't exist as a permanent Category (e.g. Season 6's
// CrystalGold, Capture). `key` is slugified from `name` at creation time (lowercase,
// non-alphanumeric -> "_"), same convention as Category.key. Values are a one-time per-commander
// total (SeasonExtraValue), not a weekly series - shared by both scoring modes, since the
// uploaded raw total is the same number either way. mode/pointsPerUnit/unitSize/flatValue are
// points-mode config (used when scoringMode === "points"); weight is positional-mode config (used
// when scoringMode === "positional"). Either, both, or neither can be set - an item with neither
// configured simply doesn't count toward either mode's score yet.
model SeasonExtraItem {
  id            Int      @id @default(autoincrement())
  seasonId      Int
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  key           String
  name          String
  mode          String? // "rate" | "flat" - points-mode config
  pointsPerUnit Float?
  unitSize      Float?
  flatValue     Float?
  weight        Float? // positional-mode config
  createdAt     DateTime @default(now())

  values SeasonExtraValue[]

  @@unique([seasonId, key])
}

// The one-time uploaded total for one commander on one season-specific item. rawValue is the
// untouched uploaded number (same "preserve the raw reading forever" convention as
// CategoryRecord.rawValue) - re-uploading overwrites it in place, there's no weekly dimension to
// dedupe against.
model SeasonExtraValue {
  id        Int             @id @default(autoincrement())
  itemId    Int
  item      SeasonExtraItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  memberId  Int
  member    Member          @relation(fields: [memberId], references: [id])
  rawValue  Float
  updatedAt DateTime        @updatedAt

  @@unique([itemId, memberId])
}

// Mirrors RawExtraction, but for season-item screenshots, which have a seasonId instead of a
// weekNumber and write into SeasonExtraValue instead of CategoryRecord/WeeklyStat. Kept as its
// own table rather than adding a nullable seasonId/making weekNumber nullable on RawExtraction -
// the two have different write targets and reusing one table for both would mean every reader of
// RawExtraction now has to branch on "is this a week one or a season one," for no real benefit.
model RawSeasonExtraction {
  id            Int      @id @default(autoincrement())
  imageFilename String
  seasonId      Int
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  itemKey       String // matches a SeasonExtraItem.key within this season - "unknown" if classification failed
  rawJson       String   @default("{}")
  confidence    Float
  status        String // "committed" | "needs_review" - no "pending_confirmation" tier: ranking_list
  // is always auto-commit-on-success, same as weekly ranking_list categories
  // (only free_text needs a person's confirmation, and season items aren't that shape)
  createdAt DateTime @default(now())
}

// One reward band for a season, in rank order. Band `order` 1 covers the top `commanderCount`
// ranked commanders, `order` 2 covers the next `commanderCount`, and so on - NOT an explicit
// rank-from/rank-to range, so reordering or resizing an earlier band automatically shifts every
// band after it. `pctOfBoxes` is a percentage (0-100) of the season's totalBoxes. Bands don't know
// or care which scoringMode produced the ranked list they're applied to.
model SeasonBand {
  id             Int    @id @default(autoincrement())
  seasonId       Int
  season         Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  order          Int
  commanderCount Int
  pctOfBoxes     Float

  @@unique([seasonId, order])
}

// Frozen per-commander result, written once when a season is finalized (mirrors
// ConductorSelection.pointsAtSelection - a snapshot, not something later data edits should move).
// `breakdown` is a JSON string recording which scoringMode produced it and the full per-category/
// per-item detail (points mode: {mode:"points", categories:{key:points}, extras:{key:points}};
// positional mode: {mode:"positional", categories:{key:{rank,n,positionalScore,weight,contribution}},
// extras:{...}}) - for the report's per-item columns and for audit if a commander disputes their
// score. `seasonScore` is generically named (not `seasonPoints`) since it holds whichever mode's
// combined total was active at finalize time.
model SeasonResult {
  id           Int      @id @default(autoincrement())
  seasonId     Int
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  memberId     Int
  member       Member   @relation(fields: [memberId], references: [id])
  rank         Int
  seasonScore  Float
  bandOrder    Int? // null = ranked below every configured band, 0 boxes
  boxesAwarded Int
  breakdown    String   @default("{}")
  createdAt    DateTime @default(now())

  @@unique([seasonId, memberId])
}

// A saved filter set for the Custom Pivot report (/dashboards/pivot) - private to whoever
// created it, never shared. `config` is the literal query string the Pivot page reads
// (e.g. "members=3,7&categories=kills,power&weeks=12") rather than separately-interpreted
// columns, so loading a saved view is just a redirect to /dashboards/pivot?<config> - the page
// can never drift out of sync with what a saved view means. No onDelete: Cascade on `creator`
// (same convention as every other Member-referencing model here) - a merge must explicitly
// move or drop these rows before deleting the merged-away member, or the delete fails on a
// RESTRICT violation.
model PivotView {
  id        Int      @id @default(autoincrement())
  creatorId Int
  creator   Member   @relation(fields: [creatorId], references: [id])
  name      String
  config    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, name])
  @@index([creatorId])
}

// A bug report or feature request submitted by any member - visible to everyone (not
// per-submitter scoped like PivotView), status changeable only by ADMIN/LEADER. No unique
// constraint tying this to one member, so a merge just moves every row, no conflict handling
// needed (unlike PivotView's name collisions). No onDelete: Cascade on `submittedBy` - same
// convention as every other Member-referencing model here - a merge must explicitly move these
// rows before deleting the merged-away member, or the delete fails on a RESTRICT violation.
model FeedbackItem {
  id            Int      @id @default(autoincrement())
  type          String // "bug" | "feature"
  title         String
  description   String
  status        String   @default("open") // "open" | "in_progress" | "resolved" | "wont_fix"
  submittedById Int
  submittedBy   Member   @relation(fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([submittedById])
  @@index([status])
  @@index([type])
}
